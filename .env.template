# ARGUS-9 Configuration Environment Variables

PORT=3000

# FRED API key (for VIX markets signal)
# Get a free key at: https://fred.stlouisfed.org/api/api_key.html
FRED_API_KEY=

# AISStream API key (for maritime AIS data)
# Get a free key at: https://aisstream.io/
AISSTREAM_API_KEY=

# OpenSky Network credentials (optional, for higher rate limits)
# Register for free at: https://opensky-network.org/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
